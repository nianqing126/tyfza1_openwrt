#!/bin/sh
# 首次开机 uci-defaults：把 PON 转发引擎与软件/硬件 flow offload 固化为出厂默认。
#
# 为什么需要它（对应实测的 5G 吞吐卡在 400~500 Mbps）：
#   上游 base-files/etc/uci-defaults/91-tyfza1-pon-offload 写的是
#     uci -q get 'firewall.@defaults[0].flow_offloading_hw' >/dev/null && exit 0
#   即「只要这个键存在就退出」。若某次配置迁移把它写成了 0，或者用户曾手动
#   关闭过，脚本永远不会纠正，设备就一直走 ARM A53 软件转发路径。
#   /etc/init.d/pon 的 offload() 也是按这两个 firewall 标志来决定是否
#   往 /sys/bus/platform/devices/4f5500000.pon/fe 写 1 的。
#
# 本脚本执行序在 91 之后（uci-defaults 按文件名排序），无条件把三项纠正为 1。
# uci-defaults 只在首次开机运行、跑完即删除；sysupgrade 保留配置时不会重跑，
# 因此不会覆盖用户后续在 LuCI 里的自定义设置。
#
# 不写 PPPoE 账号密码、不写 PON SN/MAC/LOID、不写校准数据：
# 那些属于设备数据与用户凭据，必须由使用者自行填写。

changed=0

if [ "$(uci -q get firewall.@defaults[0].flow_offloading)" != "1" ]; then
  uci -q set firewall.@defaults[0].flow_offloading='1'
  changed=1
fi
if [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" != "1" ]; then
  uci -q set firewall.@defaults[0].flow_offloading_hw='1'
  changed=1
fi
if [ "$(uci -q get pon.pon.offload)" != "1" ]; then
  uci -q set pon.pon.offload='1'
  changed=1
fi

if [ "$changed" = "1" ]; then
  uci -q commit firewall
  uci -q commit pon
  logger -t tyfza1-offload "PON FE + software/hardware flow offload enabled at first boot"
fi

# 立即让本次开机也生效（不必等下一次 firewall reload）
[ -x /etc/init.d/pon ] && /etc/init.d/pon offload >/dev/null 2>&1 || true

exit 0
